{
  "name": "cbt-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*", "/privacy", "/sitemap.xml", "/robots.txt", "/ads.txt", "/ads-config.js"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cbt", "database_id": "local-dev-placeholder", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "cbt.guidejung.com", "custom_domain": true }],
  // ADSENSE_SLOT_INARTICLE이 비어 있으면 그 자리에 디스플레이 광고 단위를 대신 쓴다.
  "vars": {
    "SITE_NAME": "CBT 기출 학습",
    "SITE_URL": "https://cbt.guidejung.com",
    "CONTACT_EMAIL": "kenshin240919@gmail.com",
    "ADSENSE_CLIENT": "ca-pub-3087515825675332",
    "ADSENSE_SLOT_DISPLAY": "6639512269",
    "ADSENSE_SLOT_INARTICLE": ""
  }
}
